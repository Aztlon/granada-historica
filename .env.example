# URL opcional de un estilo compatible con MapLibre.
# Si no se indica, la aplicación usa el estilo Liberty de OpenFreeMap.
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Opcional. Token de sitio de Cloudflare Web Analytics (no es una clave secreta).
# Déjalo vacío para desactivar la analítica, como ocurre por defecto en desarrollo.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=

# Origen canónico usado para generar los QR del piloto M7.
PUBLIC_SITE_URL=https://aztlon.github.io/granada-historica
