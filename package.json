{
  "name": "granada-historica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:internal": "vite --mode internal",
    "prebuild": "npm run periods:check && npm run validate:data && npm run qr:generate",
    "build": "tsc -b && vite build && tsx scripts/create-place-entrypoints.ts && tsx scripts/verify-m7-build.ts && tsx scripts/verify-m10-4-build.ts --public",
    "build:internal": "npm run prebuild && tsc -b && vite build --mode internal --outDir dist-internal && tsx scripts/verify-m10-4-build.ts --internal",
    "gis:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gis-bootstrap.ps1 -Force",
    "gis:c1550:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gis-c1550-bootstrap.ps1 -Force",
    "gis:c1550:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gis-c1550-export.ps1",
    "gis:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gis-export.ps1",
    "gis:period:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gis-period-bootstrap.ps1 -Force",
    "gis:period:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gis-period-export.ps1",
    "lint": "eslint .",
    "m10:3:assemble": "tsx scripts/assemble-m10-3-slice.ts",
    "m10:5:assemble": "npm run m10:5:sources && npm run m10:5:evidence && npm run m10:5:geometry:1 && npm run m10:5:geometry:2 && tsx scripts/assemble-m10-5-candidate.ts",
    "m10:5:geometry:1": "tsx scripts/assemble-m10-5-geometry-wave-1.ts",
    "m10:5:geometry:2": "tsx scripts/assemble-m10-5-geometry-wave-2.ts",
    "m10:5:evidence": "tsx scripts/assemble-m10-5-evidence-preparation.ts",
    "m10:5:sources": "npm run m10:5:sources:1 && npm run m10:5:sources:2 && npm run m10:5:sources:3 && npm run m10:5:sources:4",
    "m10:5:sources:1": "tsx scripts/assemble-m10-5-source-tranche.ts",
    "m10:5:sources:2": "tsx scripts/assemble-m10-5-source-tranche-2.ts",
    "m10:5:sources:3": "tsx scripts/assemble-m10-5-source-tranche-3.ts",
    "m10:5:sources:4": "tsx scripts/assemble-m10-5-source-tranche-4.ts",
    "preview": "vite preview",
    "periods:check": "tsx scripts/generate-period-compat.ts --check",
    "periods:generate": "tsx scripts/generate-period-compat.ts",
    "qr:generate": "tsx scripts/generate-m7-assets.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:internal": "npm run build:internal && node scripts/run-e2e.mjs e2e/m10-4.spec.ts",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
